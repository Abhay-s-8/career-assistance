# ============================================================
# SIYA — 3D AI Career Companion Environment Configuration
# ============================================================
# Copy this file to .env and insert your API keys.
# NEVER commit your actual .env file to Git or public repos.

# Google Gemini API Key (Recommended for open reasoning & interview coaching)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs Neural Voice API Key (Optional for photorealistic studio speech)
# Get your API key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI API Key (Optional alternative engine)
OPENAI_API_KEY=
